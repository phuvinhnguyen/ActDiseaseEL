; if Squeue does not work, use this together with the environment.yml file
Bootstrap: docker
From: quay.io/condaforge/miniforge3:latest

%files
    environment.yml

%post
    /opt/conda/bin/mamba env update -n base -f environment.yml
    /opt/conda/bin/conda run -n deepseekocr pip install flash-attn==2.7.3 --no-build-isolation